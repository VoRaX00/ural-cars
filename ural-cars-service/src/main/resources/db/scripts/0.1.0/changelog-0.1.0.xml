<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="create schema" author="kerzhakov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS ural_cars
        </sql>
    </changeSet>

    <changeSet id="create table cars" author="kerzhakov">
        <createTable tableName="cars">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="car_type" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="car_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="car_model" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="year_production" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="user_uuid" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
         </createTable>
    </changeSet>

    <changeSet id="add column vin_number to cars" author="kerzhakov">
        <addColumn tableName="cars">
            <column name="vin_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add column fileIds" author="kerzhakov">
        <addColumn tableName="cars">
            <column name="file_ids" type="JSONB"/>
        </addColumn>
    </changeSet>
    
    <changeSet id="add columns loan capacity, body and loading type" author="kerzhakov">
        <addColumn tableName="cars">
            <column name="load_capacity" type="DECIMAL"/>
            <column name="body_type" type="JSONB"/>
            <column name="loading_type" type="JSONB"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>